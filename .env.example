# Required ElevenLabs API key for voice synthesis.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional ElevenLabs voice ID for the meditation guide (defaults to the Grandpa voice).
ELEVENLABS_VOICE_ID=NOpBlnGInO9m6vDvFkFC

# Public Supabase credentials for the client to connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional site URL override used for auth redirects.
NEXT_PUBLIC_SITE_URL=

# Copy this file to `.env` and replace placeholders with your own values.
# The real `.env` file is gitignored so your secrets stay local.
